# timap dual-topology TI masks
# n_dual= 14  n_shared= 11  dummy_in_lambda0= 2  dummy_in_lambda1= 1
# lambda 0 = template (real unmatched, dummy insertions)
# lambda 1 = target   (real insertions, dummy unmatched)
# pmemd: scmask1 is unique to lambda 0; scmask2 is unique to lambda 1.
scmask1=":1@H1"
scmask2=":1@O1,:1@HO1"
